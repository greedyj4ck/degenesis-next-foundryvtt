<div class="currency-container">

    <div class="text-title">{{localize "UI.TABS.currency"}}</div>



    <div class="currency-group">
        <div class="currency-row">

            <input class="field-input" type="text" name="system.currency.drafts" value="{{system.currency.drafts}}" />
            <i class="di di-draft"></i>
            <label>{{localize "DGNS.CURRENCY.drafts"}}</label>

        </div>


        <div class="currency-row">

            <input class="field-input" type="text" name="system.currency.dinars" value="{{system.currency.dinars}}" />
            <i class="di di-dinar"></i>
            <label>{{localize "DGNS.CURRENCY.dinars"}}</label>

        </div>
    </div>





</div>