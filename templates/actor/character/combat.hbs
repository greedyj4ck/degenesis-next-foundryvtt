<section class="sheet-section tab combat {{tab.cssClass}}" data-group="main" data-tab="combat">


    <div class="grid">

        <div class="items">
            <fieldset class="weapons document-table scrollable">
                <legend>WEAPONS</legend>
                <div class="entries">
                    {{#each inventory.types.weapon.items as |item|}}
                        {{>"dgns.combat.weapon" collapsible=true weapon=item expanded=item.expanded }}
                    {{/each}}
                </div>

            </fieldset>


            <fieldset class="armor document-table scrollable">
                <legend>ARMOR ({{system.general.armor}})</legend>
                <div class="entries">
                    {{#each inventory.types.armor.items as |item|}}
                        {{>"dgns.combat.armor" collapsible=true armor=item expanded=item.expanded }}
                    {{/each}}
                </div>
            </fieldset>

        </div>

        <div class="actions">


            <fieldset class="state">
                <legend>STATE</legend>

                {{#each combatActions.general}}

                    <div class="action inline">
                        <div class="label">{{localize label}}</div>
                        <div class="value">
                            <button type="button" data-action="rollAction" data-key="{{key}}">{{pool}}D</button>
                        </div>
                    </div>
                {{/each}}


                <div class="state inline">
                    <div class="label">ACTIVE</div>
                    <div class="value"> <input class="field-checkbox" type="checkbox" name="system.state.active"
                            {{checked system.state.active}} /></div>

                </div>
                <div class="state inline">
                    <div class="label">IN MOTION</div>
                    <div class="value"> <input class="field-checkbox" type="checkbox" name="system.state.active"
                            {{checked system.state.active}} /></div>

                </div>


            </fieldset>

            <fieldset class="attack">
                <legend>ATTACK<dgns-die value="5"></dgns-die></legend>
                {{#each combatActions.attack}}
                    <div class="action inline">
                        <div class="label">{{localize label}}</div>
                        <div class="value">
                            <button type="button" data-action="rollAction" data-key="{{key}}">{{pool}}D</button>
                        </div>
                    </div>
                {{/each}}
            </fieldset>



            <fieldset class="defense">
                <legend>DEFENSE<dgns-die value="5"></dgns-die> </legend>



                <div class="state inline cover">
                    <div class="label">COVER</div>
                    <div class="value">{{system.state.cover}}</div>
                </div>

                <div class="state inline passive">
                    <div class="label">PASSIVE DEFENSE</div>
                    <div class="value">{{system.fighting.passiveDefense}}</div>
                </div>

                <div class="state inline armor">
                    <div class="label">ARMOR</div>
                    <div class="value">{{system.general.armor}}</div>
                </div>



                {{#each combatActions.defense}}
                    <div class="action inline">
                        <div class="label">{{localize label}}</div>
                        <div class="value">
                            <button type="button" data-action="rollAction" data-key="{{key}}">{{pool}}D</button>
                        </div>
                    </div>
                {{/each}}
            </fieldset>

        </div>








    </div>











</section>