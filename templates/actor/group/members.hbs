<section class="sheet-section tab members  {{tab.cssClass}} scrollable" data-group="main" data-tab="members">
    <div class="members-container">



        {{#each members}}
            {{#with actor}}

                <fieldset class="member">
                    <legend>{{name}}</legend>

                    <div class="row">

                        <div class="portrait image">

                            <div class="border"><svg width="100%" height="100%" viewBox="0 0 110 110" version="1.1"
                                    style="fill-rule:evenodd;clip-rule:evenodd;stroke-miterlimit:10;">
                                    <rect x="6.1" y="6.1" width="97.8" height="97.8" class="rectangle" />
                                    <rect x="9.5" y="103.9" width="90.4" height="4.2" class="rectangle" />
                                    <rect x="9.8" y="1.9" width="90.4" height="4.2" class="rectangle" />
                                    <rect x="106.1" y="25.2" width="3.5" height="3.5" class="rectangle" />
                                    <path d="M107.9,25.2L107.9,9.6" class="line" />
                                    <path d="M104,9.9L108,9.9" class="line" />
                                    <rect x="0.4" y="81.6" width="3.5" height="3.5" class="rectangle" />
                                    <path d="M2.1,85.1L2.1,100.7" class="line" />
                                    <path d="M6,100.4L2,100.4" class="line" />
                                    <path d="M2.1,9.5L2.1,63.7" class="line" />
                                    <path d="M6,9.9L2,9.9" class="line" />
                                    <path d="M107.8,100.6L107.8,46.5" class="line" />
                                    <path d="M104,100.2L108,100.2" class="line" />
                                    <rect x="6.5" y="6.5" width="97" height="97" class="rectangle" />
                                </svg></div>
                            <div class="content">
                                <img class="profile-img" src="{{img}}" data-edit="img" title="{{name}}" />
                            </div>
                        </div>


                        <div class="data condition">
                            <div class="entry ego">
                                <div class="label">{{localize "DGNS.CONDITION.ego"}}</div>
                                <div class="value">{{system.condition.ego.value}}</div>
                                <div class="separator"><i class="fa-sharp fa-regular fa-diamond"></i></div>
                                <div class="max"> {{system.condition.ego.max}}</div>
                            </div>
                            <div class="entry fleshwounds">
                                <div class="label">{{localize "DGNS.CONDITION.fleshwounds"}}</div>
                                <div class="value">{{system.condition.fleshwounds.value}}</div>
                                <div class="separator"><i class="fa-sharp fa-regular fa-diamond"></i></div>
                                <div class="max"> {{system.condition.fleshwounds.max}}</div>
                            </div>
                            <div class="entry trauma">
                                <div class="label">{{localize "DGNS.CONDITION.trauma"}}</div>
                                <div class="value">{{system.condition.trauma.value}}</div>
                                <div class="separator"><i class="fa-sharp fa-regular fa-diamond"></i></div>
                                <div class="max"> {{system.condition.trauma.max}}</div>
                            </div>
                            <div class="entry spore">
                                <div class="label">{{localize "DGNS.CONDITION.spore"}}</div>
                                <div class="value">{{system.condition.spore.value}}</div>
                                <div class="separator"><i class="fa-sharp fa-regular fa-diamond"></i></div>
                                <div class="permanent"> {{system.condition.spore.permanent}}</div>
                                <div class="separator"><i class="fa-sharp fa-regular fa-diamond"></i></div>
                                <div class="max"> {{system.condition.spore.max}}</div>
                            </div>

                        </div>

                        <div class="data stacked  ccc">
                            <div class="entry stacked culture">
                                <div class="label">{{system.culture.name}}</div>
                                <div class="image"><img src="{{system.culture.img}}" /></div>

                            </div>
                            <div class="entry stacked concept">
                                <div class="label">{{system.concept.name}}</div>
                                <div class="image"><img src="{{system.concept.img}}" /></div>
                            </div>
                            <div class="entry stacked cult">
                                <div class="label">{{system.cult.name}}</div>
                                <div class="image"><img src="{{system.cult.img}}" /></div>
                            </div>
                        </div>



                    </div>

                </fieldset>


            {{/with}}
        {{/each}}




    </div>



</section>