<div class="entry filled  item collapsible" data-drag data-item-id="{{weapon.id}}" data-expand-id="{{weapon.id}}"
    data-action="openItemContextMenu">

    <div class="entry-row">
        <div class="field image">
            <img src="{{weapon.img}}">
        </div>
        <div class="field name">
            <a class="caption" data-action="rollWeapon">{{weapon.name}}</a>
            <div class="subcaption">{{localizeConcat "DGNS.WEAPON." weapon.system.group}}</div>
        </div>


        <div class="field encumbrance">
            {{weapon.system.encumbrance}}
        </div>
        <div class="field controls">

            <a data-action="toggleEquipped">
                <i class="fa-solid fa-shield-halved {{#if weapon.system.equipped}}active{{/if}}"></i>
            </a>
            <a data-action="toggleDropped">
                <i class="fa-solid fa-sack-xmark {{#if weapon.system.dropped}}active{{/if}}"></i></a>
            <a data-action="toggleExpanded"><i class="fa-solid fa-square-caret-down"></i></a>
            <a data-action="openItemMenu"> <i class="fa-solid fa-ellipsis-vertical"></i></a>

        </div>

    </div>

    {{!--     {{#if (eq weapon.combatType "melee")}}
        <div class="entry-row actions melee">
            <button><i class="fa fa-sword"></i>Attack (2D)</button>
            <button><i class="fa fa-shield"></i>Parry (2D)</button>

        </div>
    {{/if}} --}}

    {{!--     {{#if (eq weapon.combatType "ranged")}}
        <div class="entry-row actions ranged">
            <button><i class="fa fa-sword"></i>Close (2D)</button>
            <button><i class="fa fa-sword"></i>Far (2D)</button>
            <button><i class="fa fa-sword"></i>Far as fuck (2D)</button>
            <button><i class="fa fa-sword"></i>Reload (2/10)</button>
        </div>
    {{/if}}

 --}}
    <div class="entry-row entry-dropdown collapsible-content">
        {{> "dgns.item.summary" ctx=weapon.expanded }}
    </div>



</div>