<div class="action-roll-card">

    <h2 class="action-title">{{title}}</h2>
    <h3 class="action-skill">{{attribute}} + {{skill}} {{#if difficulty}}({{difficulty}}){{/if}} </h3>
    <div class="roll-results">
        <div>{{successes}}{{localize "DGNS.UI.S"}}</div>
        <div>{{triggers}}{{localize "DGNS.UI.T"}}</div>
    </div>
    {{#if result}}
        <h2 class="roll-result {{result}}">{{resultLabel}}</h2>
    {{/if}}

    <div class="dice">

        {{log dice}}

        {{#each dice as |die d|}}
            <span class="dgns-die" data-value="{{die.result}}"></span>
        {{/each}}
    </div>



</div>