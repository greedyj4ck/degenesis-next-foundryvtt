{
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "paths": {
      "@client/*": ["./foundry/client/*"],
      "@common/*": ["./foundry/common/*"]
    }
  },
  "exclude": ["node_modules", "**/node_modules/*"],
  "include": [
    "**/*.mjs",
    "**/*.js",
    "degenesis.mjs",
    "foundry/client/client.mjs",
    "foundry/client/global.d.mts",
    "foundry/common/primitives/global.d.mts",
    "src/module/.old/.old.chat.js",
    "src/module/.old/.old.combat-degenesis.js",
    "src/module/.old/.old.chat-message.js",
    "src/module/.old/.old.utility.js",
    "src/module/.old.modifier-manager.js"
  ],
  "typeAcquisition": {
    "include": ["jquery"]
  }
}
